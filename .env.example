# simulation-backend — copy to .env for local overrides (never commit .env).
# All values are optional; defaults are shown.

# Listening port and bind address. 127.0.0.1 keeps the scaffold local-only.
PORT=4000
HOST=127.0.0.1

# Single allowed browser origin for CORS (the simulation-frontend dev server).
# CORS is not authentication.
FRONTEND_ORIGIN=http://localhost:3000

# Maximum JSON request body (Express/body-parser size string).
JSON_BODY_LIMIT=100kb

# Graceful-shutdown deadline before open connections are force-closed (ms).
SHUTDOWN_TIMEOUT_MS=10000
